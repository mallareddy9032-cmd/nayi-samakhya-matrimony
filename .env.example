# ==============================================================================
# NAYI SAMAKHYA MATRIMONY (NSM) - PRODUCTION ENVIRONMENT TEMPLATE
# Sub-directory Path: /matrimony under nayisamakhya.org
# ==============================================================================

# Network & Host
PORT=8088
NODE_ENV=production
NEXT_PUBLIC_BASE_PATH=/matrimony
APP_ORIGIN=https://nayisamakhya.org

# Parent SSO Configuration (RS256 JWKS or Static PEM)
SSO_ISSUER=https://nayisamakhya.org
SSO_AUDIENCE=nayisamakhya-matrimony
SSO_JWKS_URL=https://nayisamakhya.org/.well-known/jwks.json
SSO_LOGIN_URL=https://nayisamakhya.org/login
# Alternatively supply JWT_PUBLIC_KEY (or SSO_PUBLIC_KEY) directly:
# JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"

# PostgreSQL Database (Dedicated matrimony_shared Schema, strictly NO ORM)
POSTGRES_USER=nsm_app_user
POSTGRES_PASSWORD=<STRONG_RANDOM_PASSWORD>
POSTGRES_DB=nayisamakhya
DATABASE_URL=postgres://nsm_app_user:<STRONG_RANDOM_PASSWORD>@postgres:5432/nayisamakhya?sslmode=disable

# Cryptography (DPDP PII Column-Level pgp_sym_encrypt/decrypt Passphrase, min 32 chars)
PGCRYPTO_KEY=<STRONG_RANDOM_AES256_PASSPHRASE_MIN_32_CHARS>
# Alias:
# NSM_CONTACT_KEY=<STRONG_RANDOM_AES256_PASSPHRASE_MIN_32_CHARS>

# Object Storage (MinIO / S3 - Private Bucket, AWS SigV4 Signed URLs)
MINIO_ROOT_USER=nsm_minio_admin
MINIO_ROOT_PASSWORD=<STRONG_RANDOM_PASSWORD>
S3_ENDPOINT=minio:9000
S3_BUCKET_NAME=nsm-profile-photos
S3_REGION=us-east-1
PHOTO_URL_TTL_SECONDS=300

# Firebase Authentication (Phone Auth - 10,000 Free Monthly SMS)
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyC2YzTV9rx-LDO5n7eLQ3YI1uMOF07eQjI
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=nayi-samakhya-matrimony.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=nayi-samakhya-matrimony
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=nayi-samakhya-matrimony.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=118883571200
NEXT_PUBLIC_FIREBASE_APP_ID=1:118883571200:web:f35096fe372cea43176ae5

